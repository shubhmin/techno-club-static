# ==========================================
# TECHNO SRESHTHA GUILD CONFIGURATION
# ==========================================

# 1. NEON POSTGRESQL CONNECTION STRING (Required for database & fallback storage)
# Get this from your Neon Console (https://console.neon.tech)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. S3 OBJECT STORAGE (Neon S3 / Cloudflare R2 / AWS S3)
# These are automatically read by @aws-sdk/client-s3:
AWS_ACCESS_KEY_ID="your_access_key"
AWS_SECRET_ACCESS_KEY="your_secret_key"
AWS_REGION="us-east-2"
AWS_ENDPOINT_URL_S3="https://s3.us-east-2.amazonaws.com"
S3_BUCKET="assets"

# Optional: Custom Public CDN / Domain for uploaded assets
# S3_PUBLIC_URL="https://assets.yourdomain.com"
