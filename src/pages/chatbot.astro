---
import Base from '@/layouts/Base.astro';
import knowledgeBase from '@/data/knowledge.json';

const queryCategories = [
  {
    category: 'CYBER DEFENSE',
    items: ['What is phishing?', 'What is 2FA?', 'How to prevent malware?', 'What is a firewall?'],
  },
  {
    category: 'ETHICAL AI & INTEGRITY',
    items: ['What is AI bias?', 'How to avoid AI plagiarism?', 'What are safe AI prompts?', 'What is AI hallucination?'],
  },
  {
    category: 'ADVANCED CONCEPTS',
    items: ['What is Zero Trust?', 'What is DDoS attack?', 'What is least privilege?', 'What is data minimization?'],
  },
];
---

<Base title="AI Security Terminal — Techno Sreshtha" activePage="chatbot">
  <section class="py-12 sm:py-16">
    <div class="tech-container max-w-4xl">
      <!-- Title & Header -->
      <div class="mb-8">
        <div class="flex items-center gap-2 mb-2">
          <span class="tech-badge">INTERACTIVE ASSISTANT</span>
          <span class="text-xs font-mono text-emerald-500 flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            SECURITY ENGINE v2.4 ONLINE
          </span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-neutral-900 dark:text-white">
          Cybersecurity &amp; AI Terminal
        </h1>
        <p class="text-sm text-neutral-600 dark:text-neutral-400 mt-2 max-w-2xl">
          Query our localized knowledge engine regarding network security, defensive practices, algorithmic fairness, and safe school AI guidelines.
        </p>
      </div>

      <!-- Terminal Window -->
      <div class="cyber-card p-0 overflow-hidden shadow-2xl border-neutral-300 dark:border-white/10 bg-white dark:bg-[#080b11]">
        <!-- Terminal Top Bar -->
        <div class="flex items-center justify-between px-4 py-3 border-b border-black/[0.06] dark:border-white/[0.08] bg-neutral-100 dark:bg-[#0c1017]">
          <div class="flex items-center gap-2">
            <div class="flex gap-1.5">
              <span class="w-3 h-3 rounded-full bg-red-500/80"></span>
              <span class="w-3 h-3 rounded-full bg-yellow-500/80"></span>
              <span class="w-3 h-3 rounded-full bg-emerald-500/80"></span>
            </div>
            <span class="text-xs font-mono text-neutral-500 ml-2">ts-security-cli // localhost:8080</span>
          </div>
          <div class="flex items-center gap-3 text-[11px] font-mono text-neutral-400">
            <span>MODE: KNOWLEDGE-BASE</span>
            <button id="clear-btn" class="hover:text-red-500 transition-colors">CLEAR LOGS</button>
          </div>
        </div>

        <!-- Chat Conversation Area -->
        <div id="chatbox" class="h-[420px] overflow-y-auto p-5 space-y-4 font-mono text-xs">
          <!-- Initial Bot Message -->
          <div class="flex items-start gap-3">
            <div class="w-7 h-7 rounded bg-blue-600/10 border border-blue-500/20 text-blue-500 flex items-center justify-center font-bold text-[10px] shrink-0">
              TS
            </div>
            <div class="flex-1 bg-neutral-100 dark:bg-white/[0.03] border border-black/[0.05] dark:border-white/[0.06] p-3.5 rounded-lg text-neutral-800 dark:text-neutral-200">
              <div class="flex items-center justify-between mb-1 text-[10px] text-neutral-500">
                <span class="font-bold text-blue-500">TECHNO_BOT // PROTOCOL ADVISOR</span>
                <span class="timestamp">NOW</span>
              </div>
              <p class="leading-relaxed">
                Terminal initialized. Ready to answer questions on cybersecurity protocols, safe prompt usage, data minimization, and ethical school AI use. Click any preset below or enter a prompt.
              </p>
            </div>
          </div>
        </div>

        <!-- Terminal Input Bar -->
        <div class="p-4 border-t border-black/[0.06] dark:border-white/[0.08] bg-neutral-50 dark:bg-[#0c1017]">
          <form id="chat-form" class="flex gap-2">
            <div class="relative flex-1 flex items-center">
              <span class="absolute left-3.5 font-mono text-xs text-blue-500 font-bold select-none">&gt;</span>
              <input
                id="userInput"
                type="text"
                placeholder="Ask about phishing, 2FA, zero trust, AI bias, plagiarism..."
                class="w-full pl-8 pr-4 py-2.5 rounded-lg text-xs font-mono border border-neutral-300 dark:border-white/10 bg-white dark:bg-black/60 text-neutral-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500"
                autocomplete="off"
              />
            </div>
            <button type="submit" class="btn-cyber-primary text-xs font-mono px-5">
              EXECUTE
            </button>
          </form>
        </div>
      </div>

      <!-- Quick Knowledge Presets -->
      <div class="mt-8 space-y-6">
        <h3 class="text-xs font-mono text-neutral-500 uppercase tracking-wider font-semibold">
          SUGGESTED COMMAND QUERIES
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {queryCategories.map((cat) => (
            <div class="cyber-card p-4">
              <div class="text-[11px] font-mono font-bold text-neutral-700 dark:text-neutral-300 mb-2.5">
                // {cat.category}
              </div>
              <div class="space-y-1.5">
                {cat.items.map((item) => (
                  <button
                    class="query-chip w-full text-left text-xs font-mono text-neutral-600 dark:text-neutral-400 hover:text-blue-500 dark:hover:text-blue-400 py-1 px-1.5 rounded hover:bg-neutral-100 dark:hover:bg-white/[0.04] transition-colors truncate block"
                    data-ask={item}
                  >
                    ▹ {item}
                  </button>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Chatbot Logic -->
  <script define:vars={{ knowledgeBase }}>
    const chatbox = document.getElementById('chatbox');
    const form = document.getElementById('chat-form');
    const input = document.getElementById('userInput');
    const clearBtn = document.getElementById('clear-btn');

    function getTime() {
      const now = new Date();
      return now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
    }

    function appendMessage(role, text) {
      const isUser = role === 'USER';
      const wrapper = document.createElement('div');
      wrapper.className = 'flex items-start gap-3';

      const avatar = document.createElement('div');
      avatar.className = isUser
        ? 'w-7 h-7 rounded bg-neutral-900 text-white dark:bg-white dark:text-neutral-950 flex items-center justify-center font-bold text-[10px] shrink-0'
        : 'w-7 h-7 rounded bg-blue-600/10 border border-blue-500/20 text-blue-500 flex items-center justify-center font-bold text-[10px] shrink-0';
      avatar.textContent = isUser ? 'YOU' : 'TS';

      const bubble = document.createElement('div');
      bubble.className = isUser
        ? 'flex-1 bg-blue-50 dark:bg-blue-500/10 border border-blue-200 dark:border-blue-500/20 p-3.5 rounded-lg text-neutral-900 dark:text-neutral-100'
        : 'flex-1 bg-neutral-100 dark:bg-white/[0.03] border border-black/[0.05] dark:border-white/[0.06] p-3.5 rounded-lg text-neutral-800 dark:text-neutral-200';

      const meta = document.createElement('div');
      meta.className = 'flex items-center justify-between mb-1 text-[10px] text-neutral-500';
      meta.innerHTML = `<span class="font-bold ${isUser ? 'text-blue-600 dark:text-blue-400' : 'text-blue-500'}">${role}</span><span>${getTime()}</span>`;

      const content = document.createElement('p');
      content.className = 'leading-relaxed break-words';
      content.textContent = text;

      bubble.appendChild(meta);
      bubble.appendChild(content);
      wrapper.appendChild(avatar);
      wrapper.appendChild(bubble);

      chatbox.appendChild(wrapper);
      chatbox.scrollTop = chatbox.scrollHeight;
    }

    function getResponse(query) {
      const lower = query.toLowerCase().trim();
      for (const key in knowledgeBase) {
        if (lower.includes(key)) {
          return knowledgeBase[key];
        }
      }
      return "Query not indexed in local knowledge database. Ask about phishing, passwords, 2FA, malware, firewalls, AI bias, hallucination, prompt safety, or plagiarism.";
    }

    function handleSubmit(e) {
      if (e) e.preventDefault();
      const text = input.value.trim();
      if (!text) return;

      appendMessage('USER', text);
      input.value = '';

      setTimeout(() => {
        const reply = getResponse(text);
        appendMessage('TECHNO_BOT', reply);
      }, 350);
    }

    form?.addEventListener('submit', handleSubmit);

    // Preset chips
    document.querySelectorAll('[data-ask]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const q = btn.getAttribute('data-ask');
        input.value = q;
        handleSubmit();
      });
    });

    clearBtn?.addEventListener('click', () => {
      chatbox.innerHTML = '';
      appendMessage('TECHNO_BOT', 'Terminal buffer flushed. Ready for next instruction.');
    });
  </script>
</Base>
