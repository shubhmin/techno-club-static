---
import Base from '@/layouts/Base.astro';
import { getGallery } from '@/lib/content';

const rawGallery = await getGallery();

// Group items by yearCategory and albumTitle
interface GroupedAlbum {
  year: string;
  category: string;
  title: string;
  description: string;
  images: Array<{ src: string; label: string }>;
}

const albumsMap = new Map<string, GroupedAlbum>();

for (const item of rawGallery) {
  const key = `${item.yearCategory}-${item.albumTitle}`;
  if (!albumsMap.has(key)) {
    albumsMap.set(key, {
      year: item.yearCategory,
      category: 'EXHIBIT',
      title: item.albumTitle,
      description: 'Documented field records and student activities.',
      images: [],
    });
  }
  albumsMap.get(key)!.images.push({
    src: item.imageUrl,
    label: item.caption,
  });
}

const albums = Array.from(albumsMap.values());
---

<Base title="Event Archives & Gallery — Techno Sreshtha" activePage="gallery">
  <section class="py-12 sm:py-16">
    <div class="tech-container">
      <!-- Section Header -->
      <div class="max-w-2xl mb-12">
        <span class="tech-badge mb-2">FIELD PHOTOGRAPHY</span>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-neutral-900 dark:text-white">
          Event Archives
        </h1>
        <p class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400 mt-3">
          Documenting our student workshops, debate championships, and awareness drives across DAV Public School, Sreshtha Vihar.
        </p>
      </div>

      <!-- Albums List -->
      <div class="space-y-16">
        {albums.map((album) => (
          <div class="cyber-card p-6 sm:p-8">
            <!-- Album Metadata Header -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-black/[0.06] dark:border-white/[0.08] mb-6 gap-2">
              <div>
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-xs font-mono font-bold text-blue-600 dark:text-blue-400">{album.year}</span>
                  <span class="text-neutral-400">/</span>
                  <span class="text-xs font-mono text-neutral-500 uppercase">{album.category}</span>
                </div>
                <h2 class="text-xl sm:text-2xl font-bold text-neutral-900 dark:text-white">{album.title}</h2>
              </div>
              <p class="text-xs text-neutral-500 dark:text-neutral-400 max-w-sm sm:text-right">
                {album.description}
              </p>
            </div>

            <!-- Image Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-5">
              {album.images.map((img) => (
                <div
                  class="group relative rounded-xl overflow-hidden cursor-pointer border border-black/[0.06] dark:border-white/[0.08] bg-neutral-100 dark:bg-black/40 aspect-[4/3]"
                  data-lightbox-trigger
                  data-src={img.src}
                  data-caption={img.label}
                  data-album={album.title}
                >
                  <img
                    src={img.src}
                    alt={img.label}
                    loading="lazy"
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-80 group-hover:opacity-100 transition-opacity flex items-end p-4">
                    <span class="text-xs font-mono text-white tracking-wide">
                      {img.label}
                    </span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Fullscreen Lightbox Modal -->
  <div id="gallery-lightbox" class="fixed inset-0 z-50 hidden bg-black/90 backdrop-blur-md flex items-center justify-center p-4">
    <div class="relative max-w-5xl w-full flex flex-col items-center">
      <!-- Top info bar -->
      <div class="w-full flex items-center justify-between text-white/80 font-mono text-xs pb-3 mb-2 border-b border-white/10">
        <span id="lightbox-album-title" class="truncate font-semibold">ALBUM</span>
        <div class="flex items-center gap-4">
          <span id="lightbox-counter">1 / 1</span>
          <button id="lightbox-close" class="p-1 rounded hover:bg-white/10 text-white transition-colors" aria-label="Close lightbox">
            ✕ ESC
          </button>
        </div>
      </div>

      <!-- Main Image Display -->
      <div class="relative w-full flex items-center justify-center aspect-[16/10] max-h-[75vh]">
        <img id="lightbox-img" src="" alt="" class="max-h-full max-w-full object-contain rounded-lg shadow-2xl" />
        
        <!-- Prev / Next Controls -->
        <button id="lightbox-prev" class="absolute left-2 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-black/60 border border-white/20 text-white flex items-center justify-center hover:bg-black/90 transition-colors" aria-label="Previous photo">
          ‹
        </button>
        <button id="lightbox-next" class="absolute right-2 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-black/60 border border-white/20 text-white flex items-center justify-center hover:bg-black/90 transition-colors" aria-label="Next photo">
          ›
        </button>
      </div>

      <!-- Caption -->
      <div id="lightbox-caption" class="w-full text-center font-mono text-xs text-white/70 pt-3">
        Caption
      </div>
    </div>
  </div>

  <script>
    const lightbox = document.getElementById('gallery-lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const lightboxCaption = document.getElementById('lightbox-caption');
    const lightboxAlbum = document.getElementById('lightbox-album-title');
    const lightboxCounter = document.getElementById('lightbox-counter');
    const closeBtn = document.getElementById('lightbox-close');
    const prevBtn = document.getElementById('lightbox-prev');
    const nextBtn = document.getElementById('lightbox-next');

    interface Item {
      src: string;
      caption: string;
      album: string;
    }

    const triggers = Array.from(document.querySelectorAll('[data-lightbox-trigger]'));
    const items: Item[] = triggers.map((el) => ({
      src: el.getAttribute('data-src') || '',
      caption: el.getAttribute('data-caption') || '',
      album: el.getAttribute('data-album') || '',
    }));

    let currentIdx = 0;

    function render() {
      const item = items[currentIdx];
      if (!item) return;
      lightboxImg.src = item.src;
      if (lightboxCaption) lightboxCaption.textContent = item.caption;
      if (lightboxAlbum) lightboxAlbum.textContent = item.album;
      if (lightboxCounter) lightboxCounter.textContent = `${currentIdx + 1} / ${items.length}`;
    }

    function open(index: number) {
      currentIdx = index;
      render();
      lightbox?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function close() {
      lightbox?.classList.add('hidden');
      document.body.style.overflow = '';
    }

    triggers.forEach((el, i) => {
      el.addEventListener('click', () => open(i));
    });

    closeBtn?.addEventListener('click', close);
    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) close();
    });

    prevBtn?.addEventListener('click', () => {
      currentIdx = (currentIdx - 1 + items.length) % items.length;
      render();
    });

    nextBtn?.addEventListener('click', () => {
      currentIdx = (currentIdx + 1) % items.length;
      render();
    });

    document.addEventListener('keydown', (e) => {
      if (lightbox?.classList.contains('hidden')) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') {
        currentIdx = (currentIdx - 1 + items.length) % items.length;
        render();
      }
      if (e.key === 'ArrowRight') {
        currentIdx = (currentIdx + 1) % items.length;
        render();
      }
    });
  </script>
</Base>
