          <div>
            <label for="ethical-ai-lead" class="block text-xs font-mono text-neutral-300 uppercase font-semibold mb-1">Charter Lead Subtext</label>
            <textarea id="ethical-ai-lead" rows="4" class="w-full px-4 py-2.5 rounded-xl text-xs font-mono border border-white/[0.09] bg-black/50 text-white" data-page="ethical-ai" data-key="lead">{ethicalAiContent.lead}</textarea>
          </div>
          <div class="flex justify-end pt-2">
            <button class="save-page-btn btn-cyber-primary text-xs font-mono font-bold" data-target="ethical-ai">SAVE ETHICAL AI COPY →</button>
          </div>
