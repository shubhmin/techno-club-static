              <label for="member-avatar" class="block text-[11px] font-mono text-neutral-400 uppercase mb-1">Avatar URL</label>
              <input type="text" id="member-avatar" placeholder="/assets/placeholder.svg or /api/media/..." class="w-full px-3.5 py-2 rounded-xl text-xs font-mono border border-white/10 bg-black/60 text-white" />
            </div>
          </div>
          <div class="flex justify-end">
            <button type="submit" class="btn-cyber-primary text-xs font-mono font-bold">+ SAVE GUILD MEMBER</button>
          </div>
        </form>

        <!-- Current members list -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
          {membersList.map((m) => (
            <div class="p-4 rounded-2xl border border-white/[0.08] bg-[#0c101a] flex items-center justify-between hover:border-white/20 transition-all">
              <div class="flex items-center gap-3.5 min-w-0">
                <img src={m.imageUrl || '/assets/placeholder.svg'} alt={m.name} class="w-11 h-11 rounded-xl object-cover ring-1 ring-white/10 bg-black/40 shrink-0" />
                <div class="min-w-0">
                  <div class="font-bold text-xs text-white truncate">{m.name}</div>
                  <div class="text-[11px] text-neutral-400 truncate">{m.role}</div>
                  <span class="inline-block mt-1 text-[9px] font-mono px-2 py-0.5 rounded-full bg-white/[0.06] text-neutral-300">
                    {m.category === 'FACULTY' ? 'Faculty Mentor' : m.category === 'CORE_STUDENT' ? 'Student Lead' : 'Contributor'}
                  </span>
                </div>
              </div>
              <button class="delete-member-btn text-xs font-mono text-red-400 hover:text-red-300 ml-2 px-2 py-1" data-id={m.id}>DELETE</button>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- TAB 6: PROJECTS -->
    <section id="tab-projects" class="tab-content hidden space-y-6">
      <div class="p-6 rounded-2xl border border-white/[0.08] bg-[#0c101a]/80 backdrop-blur-sm space-y-6">
        <div>
          <h2 class="text-sm font-mono font-bold uppercase tracking-wider text-white">// STUDENT PROJECTS & SCRATCH BUILDS</h2>
          <p class="text-xs text-neutral-400 mt-1">Manage interactive cybersecurity tools, Scratch games, and ethics modules.</p>
        </div>

        <!-- Add project form -->
        <form id="project-form" class="p-5 rounded-2xl border border-white/[0.08] bg-black/40 space-y-4">
          <div class="text-xs font-mono font-bold text-white uppercase tracking-wider">// PUBLISH NEW LAB PROJECT</div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
              <label for="project-title" class="block text-[11px] font-mono text-neutral-400 uppercase mb-1">Project Title</label>
              <input type="text" id="project-title" placeholder="e.g. Phishing Maze Scratch" required class="w-full px-3.5 py-2 rounded-xl text-xs font-mono border border-white/10 bg-black/60 text-white" />
            </div>
            <div>
              <label for="project-tag" class="block text-[11px] font-mono text-neutral-400 uppercase mb-1">Category Tag</label>
              <input type="text" id="project-tag" placeholder="e.g. SCRATCH GAME" required class="w-full px-3.5 py-2 rounded-xl text-xs font-mono border border-white/10 bg-black/60 text-white" />
            </div>
            <div>
              <label for="project-track" class="block text-[11px] font-mono text-neutral-400 uppercase mb-1">Target Wing</label>
              <input type="text" id="project-track" placeholder="e.g. JUNIOR WING (CLASSES 4–6)" required class="w-full px-3.5 py-2 rounded-xl text-xs font-mono border border-white/10 bg-black/60 text-white" />
            </div>
          </div>
          <div>
            <label for="project-desc" class="block text-[11px] font-mono text-neutral-400 uppercase mb-1">Description</label>
            <textarea id="project-desc" rows="2" placeholder="Brief outline of the learning outcomes..." required class="w-full px-3.5 py-2 rounded-xl text-xs font-mono border border-white/10 bg-black/60 text-white"></textarea>
          </div>
          <div>
            <label for="project-link" class="block text-[11px] font-mono text-neutral-400 uppercase mb-1">Interactive URL (Scratch embed, GitHub, or internal route)</label>
            <input type="text" id="project-link" placeholder="https://scratch.mit.edu/projects/... or /chatbot" class="w-full px-3.5 py-2 rounded-xl text-xs font-mono border border-white/10 bg-black/60 text-white" />
          </div>
          <div class="flex justify-end">
            <button type="submit" class="btn-cyber-primary text-xs font-mono font-bold">+ PUBLISH PROJECT</button>
          </div>
        </form>

        <!-- Current projects list -->
        <div class="space-y-3">
          {projectsList.map((p) => (
            <div class="p-4 rounded-2xl border border-white/[0.08] bg-[#0c101a] flex flex-col sm:flex-row sm:items-center justify-between gap-3 hover:border-white/20 transition-all">
              <div class="min-w-0">
                <div class="flex items-center gap-2">
                  <span class="font-bold text-xs text-white truncate">{p.title}</span>
                  <span class="text-[10px] px-2 py-0.5 rounded-full bg-blue-500/10 text-blue-400 font-mono font-medium border border-blue-500/20">{p.categoryTag}</span>
                  <span class="text-[10px] text-neutral-400 font-mono">{p.track}</span>
                </div>
                <div class="text-xs text-neutral-400 mt-1">{p.description}</div>
                {p.linkUrl && (
                  <a href={p.linkUrl} target="_blank" class="inline-block mt-1 text-[11px] font-mono text-blue-400 hover:underline">
                    {p.linkUrl} ↗
                  </a>
                )}
              </div>
              <button class="delete-project-btn text-xs font-mono text-red-400 hover:text-red-300 shrink-0 self-end sm:self-center" data-id={p.id}>DELETE</button>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- TAB 7: SECURITY AUDIT LOG -->
    <section id="tab-audit" class="tab-content hidden space-y-6">
      <div class="p-6 rounded-2xl border border-white/[0.08] bg-[#0c101a]/80 backdrop-blur-sm space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-white/[0.06]">
          <div>
            <h2 class="text-sm font-mono font-bold uppercase tracking-wider text-white">// TAMPER-EVIDENT SECURITY AUDIT TRAIL</h2>
            <p class="text-xs text-neutral-400 mt-1">Immutable forensic log of logins, mutations, and telemetry events.</p>
          </div>
          <button id="refresh-audit-btn" class="btn-cyber-outline text-xs font-mono flex items-center gap-2">
            <span>⟳</span>
            <span>REFRESH AUDIT STREAM</span>
          </button>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left font-mono text-xs border-collapse">
            <thead>
              <tr class="border-b border-white/[0.08] text-neutral-400 text-[11px]">
                <th class="py-3 px-3">TIMESTAMP</th>
                <th class="py-3 px-3">EVENT</th>
                <th class="py-3 px-3">IP ADDRESS</th>
                <th class="py-3 px-3">ACTOR</th>
                <th class="py-3 px-3">METADATA</th>
              </tr>
            </thead>
            <tbody id="audit-table-body" class="divide-y divide-white/[0.04]">
              <tr>
                <td colspan="5" class="py-6 text-center text-neutral-500 font-mono">Click "Refresh Audit Stream" to query security logs.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </main>

  <!-- Client-side Controller Script -->
  <script>
    // Tab switching controller
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabContents = document.querySelectorAll('.tab-content');

    function activateTab(targetId: string) {
      tabBtns.forEach((b) => {
        const isTarget = b.getAttribute('data-tab') === targetId;
        b.classList.toggle('active', isTarget);
        if (isTarget) {
          b.className = 'tab-btn active px-4 py-2.5 rounded-xl font-mono text-xs font-semibold transition-all flex items-center gap-2 bg-blue-600 text-white shadow-lg shadow-blue-500/20';
        } else {
          b.className = 'tab-btn px-4 py-2.5 rounded-xl font-mono text-xs font-medium text-neutral-400 hover:text-white hover:bg-white/[0.04] transition-all flex items-center gap-2';
        }
      });

      tabContents.forEach((c) => {
        c.classList.toggle('hidden', c.id !== targetId);
      });

      if (targetId === 'tab-audit') {
        loadAuditLogs();
      }
    }

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-tab');
        if (target) activateTab(target);
      });
    });

    // Quick jump buttons from stats cards
    document.querySelectorAll('.quick-jump-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-tab');
        if (target) activateTab(target);
      });
    });

    // Toast feedback helper
    const toast = document.getElementById('toast')!;
    function showToast(msg: string, isError = false) {
      toast.textContent = msg;
      toast.className = `fixed top-20 right-6 z-50 px-5 py-3 rounded-2xl font-mono text-xs shadow-2xl transition-all duration-300 ${
        isError ? 'bg-red-950/90 border border-red-500/50 text-red-200' : 'bg-emerald-950/90 border border-emerald-500/50 text-emerald-200'
      }`;
      toast.classList.remove('hidden');
      setTimeout(() => toast.classList.add('hidden'), 3500);
    }

    // Color Swatch Selection Helper
    const accentHiddenInput = document.getElementById('accentColor') as HTMLInputElement;
    document.querySelectorAll('.accent-radio').forEach((radio) => {
      radio.addEventListener('change', (e) => {
        const val = (e.target as HTMLInputElement).value;
        if (accentHiddenInput) accentHiddenInput.value = val;
      });
    });

    // Banner Live Preview Updater
    const bannerActiveCheck = document.getElementById('bannerActive') as HTMLInputElement;
    const bannerTextInput = document.getElementById('bannerText') as HTMLInputElement;
    const bannerPreview = document.getElementById('banner-preview');
    const previewText = document.getElementById('preview-text');
    const previewBadge = document.getElementById('preview-badge');

    function updateBannerPreview() {
      const active = bannerActiveCheck?.checked;
      const text = bannerTextInput?.value || 'No active announcement';
      if (previewText) previewText.textContent = text;
      if (previewBadge) {
        previewBadge.textContent = active ? 'ACTIVE' : 'DISABLED';
        previewBadge.className = `text-[10px] px-2 py-0.5 rounded-full font-semibold ${
          active ? 'bg-blue-500/20 text-blue-300' : 'bg-neutral-800 text-neutral-500'
        }`;
      }
      if (bannerPreview) {
        bannerPreview.className = `p-3 rounded-xl border text-xs font-mono flex items-center justify-between transition-all ${
          active ? 'bg-blue-950/40 border-blue-500/30 text-blue-200' : 'bg-white/[0.02] border-white/[0.06] text-neutral-500'
        }`;
      }
    }

    bannerActiveCheck?.addEventListener('change', updateBannerPreview);
    bannerTextInput?.addEventListener('input', updateBannerPreview);

    // Logout
    document.getElementById('logout-btn')?.addEventListener('click', async () => {
      await fetch('/api/admin/auth/logout', { method: 'POST' });
      window.location.href = '/admin/login';
    });

    // Save Settings
    const settingsForm = document.getElementById('settings-form') as HTMLFormElement;
    settingsForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const payload = {
        accentColor: accentHiddenInput ? accentHiddenInput.value : 'blue',
        systemStatus: (document.getElementById('systemStatus') as HTMLInputElement).value,
        bannerActive: bannerActiveCheck.checked,
        bannerText: bannerTextInput.value,
        bannerLink: (document.getElementById('bannerLink') as HTMLInputElement).value,
      };

      try {
        const res = await fetch('/api/admin/settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error('Failed to update settings');
        showToast('✓ Global settings updated successfully');
      } catch (err: any) {
        showToast(err.message, true);
      }
    });

    // Page Selector Pill Switcher
    const pagePills = document.querySelectorAll('.page-pill');
    pagePills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const target = pill.getAttribute('data-target')!;
        pagePills.forEach((p) => {
          p.classList.remove('active', 'text-white', 'bg-white/10', 'font-bold');
          p.classList.add('text-neutral-400');
        });
        pill.classList.add('active', 'text-white', 'bg-white/10', 'font-bold');
        pill.classList.remove('text-neutral-400');

        document.querySelectorAll('.page-editor').forEach((ed) => ed.classList.add('hidden'));
        document.getElementById(`editor-${target}`)?.classList.remove('hidden');
      });
    });

    // Save Page Content
    document.querySelectorAll('.save-page-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const targetPage = btn.getAttribute('data-target')!;
        const editor = document.getElementById(`editor-${targetPage}`)!;
        const inputs = editor.querySelectorAll('[data-key]');

        try {
          for (const input of inputs) {
            const sectionKey = input.getAttribute('data-key')!;
            const content = (input as HTMLInputElement | HTMLTextAreaElement).value;

            const res = await fetch('/api/admin/content', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ pageSlug: targetPage, sectionKey, content }),
            });
            if (!res.ok) throw new Error(`Failed saving ${sectionKey}`);
          }
          showToast(`✓ Saved copy for /${targetPage === 'home' ? '' : targetPage}`);
        } catch (err: any) {
          showToast(err.message, true);
        }
      });
    });

    // Event Drawer Toggle
    const eventToggleBtn = document.getElementById('add-event-toggle-btn');
    const eventForm = document.getElementById('event-form') as HTMLFormElement;
    const eventCancelBtn = document.getElementById('event-cancel-btn');

    eventToggleBtn?.addEventListener('click', () => {
      eventForm?.classList.toggle('hidden');
    });

    eventCancelBtn?.addEventListener('click', () => {
      eventForm?.classList.add('hidden');
    });

    // Add Event Form
    eventForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const payload = {
        title: (document.getElementById('event-title') as HTMLInputElement).value,
        track: (document.getElementById('event-track') as HTMLSelectElement).value,
        eventDate: (document.getElementById('event-date') as HTMLInputElement).value,
        location: (document.getElementById('event-location') as HTMLInputElement).value,
        registrationLink: (document.getElementById('event-reglink') as HTMLInputElement).value || null,
        description: (document.getElementById('event-desc') as HTMLTextAreaElement).value,
        status: 'UPCOMING',
      };

      try {
        const res = await fetch('/api/admin/events', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error('Failed to schedule event');
        showToast('✓ Event successfully scheduled');
        setTimeout(() => window.location.reload(), 1000);
      } catch (err: any) {
        showToast(err.message, true);
      }
    });

    // Delete Event
    document.querySelectorAll('.delete-event-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (!confirm('Are you sure you want to delete this event?')) return;
        const id = btn.getAttribute('data-id');
        try {
          const res = await fetch(`/api/admin/events?id=${id}`, { method: 'DELETE' });
          if (!res.ok) throw new Error('Delete failed');
          showToast('✓ Event deleted');
          setTimeout(() => window.location.reload(), 1000);
        } catch (err: any) {
          showToast(err.message, true);
        }
      });
    });

    // S3 Media Upload & Dropzone Controller
    const fileInput = document.getElementById('media-file-input') as HTMLInputElement;
    const browseBtn = document.getElementById('browse-btn');
    const dropzone = document.getElementById('dropzone');
    const uploadStatus = document.getElementById('upload-status')!;
    const galleryUrlInput = document.getElementById('gallery-image-url') as HTMLInputElement;

    browseBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      fileInput.click();
    });

    dropzone?.addEventListener('click', () => fileInput.click());

    dropzone?.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzone.classList.add('border-blue-500', 'bg-blue-950/20');
    });

    dropzone?.addEventListener('dragleave', () => {
      dropzone.classList.remove('border-blue-500', 'bg-blue-950/20');
    });

    dropzone?.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.classList.remove('border-blue-500', 'bg-blue-950/20');
      if (e.dataTransfer?.files?.length) {
        fileInput.files = e.dataTransfer.files;
        handleFileUpload(e.dataTransfer.files[0]);
      }
    });

    fileInput?.addEventListener('change', () => {
      const file = fileInput.files?.[0];
      if (file) handleFileUpload(file);
    });

    async function handleFileUpload(file: File) {
      uploadStatus.textContent = `Uploading ${file.name} to Neon S3 storage...`;
      uploadStatus.classList.remove('hidden');

      const formData = new FormData();
      formData.append('file', file);

      try {
        const res = await fetch('/api/admin/media', {
          method: 'POST',
          body: formData,
        });

        const contentType = res.headers.get('content-type') || '';
        let data: any = {};
        if (contentType.includes('application/json')) {
          data = await res.json();
        } else {
          const text = await res.text();
          throw new Error(text || `Server returned ${res.status}`);
        }

        if (!res.ok) throw new Error(data.error || 'Upload failed');

        const storageType = data.storage === 's3' ? 'Neon S3' : 'Database';
        uploadStatus.innerHTML = `✓ Uploaded to <strong>${storageType}</strong>! Permanent Link: <span class="text-white underline">${data.url}</span>`;
        if (galleryUrlInput) galleryUrlInput.value = data.url;
        showToast(`✓ Image uploaded to ${storageType}`);
      } catch (err: any) {
        uploadStatus.textContent = `Upload failed: ${err.message}`;
        showToast(err.message, true);
      }
    }

    // Copy to clipboard helper
    document.querySelectorAll('.copy-url-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const url = btn.getAttribute('data-url');
        if (url) {
          navigator.clipboard.writeText(url);
          showToast('✓ Image URL copied to clipboard');
        }
      });
    });

    // Add Gallery Item
    const galleryForm = document.getElementById('gallery-form') as HTMLFormElement;
    galleryForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const payload = {
        yearCategory: (document.getElementById('gallery-year') as HTMLInputElement).value,
        albumTitle: (document.getElementById('gallery-album') as HTMLInputElement).value,
        caption: (document.getElementById('gallery-caption') as HTMLInputElement).value,
        imageUrl: galleryUrlInput.value,
      };

      try {
        const res = await fetch('/api/admin/gallery', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error('Failed to add gallery item');
        showToast('✓ Added photo to exhibit gallery');
        setTimeout(() => window.location.reload(), 1000);
      } catch (err: any) {
        showToast(err.message, true);
      }
    });

    // Delete Gallery Item
    document.querySelectorAll('.delete-gallery-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (!confirm('Delete this exhibit image?')) return;
        const id = btn.getAttribute('data-id');
        try {
          const res = await fetch(`/api/admin/gallery?id=${id}`, { method: 'DELETE' });
          if (!res.ok) throw new Error('Delete failed');
          showToast('✓ Exhibit image removed');
          setTimeout(() => window.location.reload(), 1000);
        } catch (err: any) {
          showToast(err.message, true);
        }
      });
    });

    // Add Member
    const memberForm = document.getElementById('member-form') as HTMLFormElement;
    memberForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const payload = {
        name: (document.getElementById('member-name') as HTMLInputElement).value,
        role: (document.getElementById('member-role') as HTMLInputElement).value,
        category: (document.getElementById('member-category') as HTMLSelectElement).value,
        imageUrl: (document.getElementById('member-avatar') as HTMLInputElement).value || '/assets/placeholder.svg',
      };
      try {
        const res = await fetch('/api/admin/members', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error('Failed to save member');
        showToast('✓ Member registered');
        setTimeout(() => window.location.reload(), 1000);
      } catch (err: any) {
        showToast(err.message, true);
      }
    });

    // Delete Member
    document.querySelectorAll('.delete-member-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (!confirm('Remove this member?')) return;
        const id = btn.getAttribute('data-id');
        try {
          const res = await fetch(`/api/admin/members?id=${id}`, { method: 'DELETE' });
          if (!res.ok) throw new Error('Delete failed');
          showToast('✓ Member removed');
          setTimeout(() => window.location.reload(), 1000);
        } catch (err: any) {
          showToast(err.message, true);
        }
      });
    });

    // Add Project
    const projectForm = document.getElementById('project-form') as HTMLFormElement;
    projectForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const payload = {
        title: (document.getElementById('project-title') as HTMLInputElement).value,
        categoryTag: (document.getElementById('project-tag') as HTMLInputElement).value,
        track: (document.getElementById('project-track') as HTMLInputElement).value,
        description: (document.getElementById('project-desc') as HTMLTextAreaElement).value,
        linkUrl: (document.getElementById('project-link') as HTMLInputElement).value,
        status: 'ACTIVE',
      };
      try {
        const res = await fetch('/api/admin/projects', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error('Failed to add project');
        showToast('✓ Project published');
        setTimeout(() => window.location.reload(), 1000);
      } catch (err: any) {
        showToast(err.message, true);
      }
    });

    // Delete Project
    document.querySelectorAll('.delete-project-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (!confirm('Remove this project?')) return;
        const id = btn.getAttribute('data-id');
        try {
          const res = await fetch(`/api/admin/projects?id=${id}`, { method: 'DELETE' });
          if (!res.ok) throw new Error('Delete failed');
          showToast('✓ Project removed');
          setTimeout(() => window.location.reload(), 1000);
        } catch (err: any) {
          showToast(err.message, true);
        }
      });
    });

    // Load Audit Logs
    async function loadAuditLogs() {
      const tbody = document.getElementById('audit-table-body')!;
      tbody.innerHTML = '<tr><td colspan="5" class="py-6 text-center text-neutral-400 font-mono">Querying security audit records...</td></tr>';
      try {
        const res = await fetch('/api/admin/audit');
        const logs = await res.json();
        if (!Array.isArray(logs) || logs.length === 0) {
          tbody.innerHTML = '<tr><td colspan="5" class="py-6 text-center text-neutral-500 font-mono">No audit records found yet.</td></tr>';
          return;
        }

        tbody.innerHTML = logs
          .map(
            (l: any) => `
          <tr class="hover:bg-white/[0.02] transition-colors">
            <td class="py-3 px-3 text-neutral-400 whitespace-nowrap font-mono text-[11px]">${new Date(l.timestamp).toLocaleString()}</td>
            <td class="py-3 px-3 font-bold ${
              l.eventType.includes('SUCCESS') ? 'text-emerald-400' : l.eventType.includes('FAIL') ? 'text-red-400' : 'text-blue-400'
            }">
              <span class="px-2 py-0.5 rounded-full text-[10px] font-mono ${
                l.eventType.includes('SUCCESS') ? 'bg-emerald-500/10 text-emerald-300 border border-emerald-500/20' : l.eventType.includes('FAIL') ? 'bg-red-500/10 text-red-300 border border-red-500/20' : 'bg-blue-500/10 text-blue-300 border border-blue-500/20'
              }">${l.eventType}</span>
            </td>
            <td class="py-3 px-3 text-neutral-300 font-mono text-[11px]">${l.ipAddress}</td>
            <td class="py-3 px-3 text-neutral-200 font-medium">${l.actorUsername || 'system'}</td>
            <td class="py-3 px-3 text-neutral-400 max-w-xs truncate text-[11px] font-mono">${l.details || '-'}</td>
          </tr>`
          )
          .join('');
      } catch (err) {
        tbody.innerHTML = '<tr><td colspan="5" class="py-6 text-center text-red-400 font-mono">Failed to query audit records.</td></tr>';
      }
    }

    document.getElementById('refresh-audit-btn')?.addEventListener('click', loadAuditLogs);
  </script>
</body>
</html>
