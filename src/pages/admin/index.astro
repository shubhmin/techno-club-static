          </div>
        </div>
      </div>
    </section>

    <!-- TAB 3: EVENTS & MISSIONS -->
    <section id="tab-events" class="tab-content hidden space-y-6">
      <div class="p-6 rounded-2xl border border-white/[0.08] bg-[#0c101a]/80 backdrop-blur-sm space-y-6">
