          </div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
              <label for="home-statMembers" class="block text-[11px] font-mono text-neutral-400 uppercase mb-1">Members Stat Label</label>
              <input type="text" id="home-statMembers" class="w-full px-4 py-2 rounded-xl text-xs font-mono border border-white/[0.09] bg-black/50 text-white" data-page="home" data-key="statMembers" value={homeContent.statMembers} />
            </div>
            <div>
              <label for="home-statLabs" class="block text-[11px] font-mono text-neutral-400 uppercase mb-1">Labs Stat Label</label>
