            </div>
            <button type="button" id="browse-btn" class="pointer-events-auto inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-mono border border-white/10 bg-white/[0.05] hover:bg-white/10 text-white transition-all">
