---
import '@/styles/global.css';
import { validateSession } from '@/lib/auth';
import { hasDb } from '@/lib/db/client';
import { isS3Configured, getBucket } from '@/lib/s3';
import {
  getSiteSettings,
  getPageContent,
  getEvents,
  getGallery,
  getMembers,
  getProjects,
} from '@/lib/content';

const session = await validateSession(Astro.cookies);
if (!session) {
  return Astro.redirect('/admin/login');
}

const dbConnected = hasDb();
const s3Connected = isS3Configured();
const s3Bucket = getBucket();
const settings = await getSiteSettings();
const homeContent = await getPageContent('home');
const aboutContent = await getPageContent('about');
const ethicalAiContent = await getPageContent('ethical-ai');
const projectsContent = await getPageContent('projects');
const contactContent = await getPageContent('contact');
const eventsList = await getEvents();
const galleryList = await getGallery();
const membersList = await getMembers();
const projectsList = await getProjects();
---

<!doctype html>
<html lang="en" class="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Operator Dashboard — Techno Sreshtha</title>
  <link rel="icon" href="/assets/logo.webp" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</head>

<body class="min-h-screen bg-[#07090e] text-neutral-100 font-sans selection:bg-blue-500/20 antialiased overflow-x-hidden">
  <!-- Subtle ambient illumination (warm obsidian aura) -->
  <div class="fixed inset-0 pointer-events-none z-0">
    <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[1000px] h-[450px] bg-gradient-to-b from-blue-600/10 via-indigo-500/5 to-transparent blur-3xl rounded-full"></div>
    <div class="absolute top-80 right-0 w-[500px] h-[300px] bg-emerald-500/5 blur-3xl rounded-full"></div>
    <div class="absolute inset-0 bg-grid-pattern opacity-10 [mask-image:radial-gradient(ellipse_80%_60%_at_50%_0%,#000_70%,transparent_100%)]"></div>
  </div>

  <!-- Top Glass Navigation Bar -->
  <header class="sticky top-0 z-40 backdrop-blur-xl bg-[#090d15]/80 border-b border-white/[0.07] transition-all">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
      <!-- Left brand & system badge -->
      <div class="flex items-center gap-3.5">
        <a href="/admin" class="flex items-center gap-3 group">
          <div class="relative">
            <img src="/assets/logo.webp" alt="Logo" class="h-9 w-9 rounded-xl ring-1 ring-white/10 group-hover:ring-blue-500/40 transition-all shadow-md shadow-black/40" />
            <span class="absolute -bottom-0.5 -right-0.5 flex h-2.5 w-2.5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500 ring-2 ring-[#090d15]"></span>
            </span>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="font-extrabold text-sm tracking-tight text-white group-hover:text-blue-400 transition-colors">TECHNO SRESHTHA</span>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-blue-500/10 text-blue-400 border border-blue-500/20 font-medium">ADMIN v2.0</span>
            </div>
            <div class="text-[11px] font-mono text-neutral-400 flex items-center gap-1.5">
              <span>DAV Sreshtha Vihar</span>
              <span class="text-neutral-600">/</span>
              <span class="text-neutral-300">Operator: <strong class="text-white font-medium">{session.user.username}</strong></span>
            </div>
          </div>
        </a>
      </div>

      <!-- Right cluster actions -->
      <div class="flex items-center gap-2.5 sm:gap-3">
        <!-- Live storage health pill -->
        <div class="hidden md:flex items-center gap-2 px-3 py-1.5 rounded-xl border border-white/[0.08] bg-white/[0.02] text-xs font-mono">
          <span class="w-2 h-2 rounded-full bg-emerald-400 shadow-sm shadow-emerald-400/50"></span>
          <span class="text-neutral-300">Storage:</span>
          <span class="text-emerald-400 font-semibold">{s3Connected ? `S3 (${s3Bucket})` : 'Postgres DB'}</span>
        </div>

        <a
          href="/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-white/10 text-xs font-mono text-neutral-300 hover:text-white hover:bg-white/[0.06] hover:border-white/20 transition-all shadow-sm"
          title="Open public website in new tab"
        >
          <span>Live Site</span>
          <svg class="w-3.5 h-3.5 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>

        <button
          id="logout-btn"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl text-xs font-mono font-medium bg-red-500/10 hover:bg-red-500/20 text-red-300 border border-red-500/20 transition-all hover:scale-[1.02] active:scale-[0.98]"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
          </svg>
          <span class="hidden sm:inline">Sign Out</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Main Container -->
  <main class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-8 space-y-6 sm:space-y-8">
    <!-- Toast Feedback Container -->
    <div id="toast" class="fixed top-20 right-6 z-50 hidden px-4 py-3 rounded-2xl font-mono text-xs shadow-2xl backdrop-blur-xl transition-all duration-300 animate-slide-in"></div>

    <!-- 1. STATS & HEALTH OVERVIEW (Warmth Anchor) -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
      <!-- Stat 1: Storage & DB -->
      <div class="group p-4 sm:p-5 rounded-2xl border border-white/[0.08] bg-[#0c101a]/80 backdrop-blur-sm hover:border-emerald-500/30 transition-all">
        <div class="flex items-center justify-between mb-2">
          <span class="text-[11px] font-mono uppercase tracking-wider text-neutral-400">Database & Cloud</span>
          <span class="flex h-2 w-2 rounded-full bg-emerald-400"></span>
        </div>
        <div class="text-lg sm:text-xl font-bold tracking-tight text-white flex items-center gap-2">
          <span>Neon + S3</span>
        </div>
        <div class="text-[11px] font-mono text-emerald-400/90 mt-1 flex items-center gap-1">
          <span>✓ Edge Immutable Cache</span>
        </div>
      </div>

      <!-- Stat 2: Events -->
      <button class="quick-jump-btn text-left p-4 sm:p-5 rounded-2xl border border-white/[0.08] bg-[#0c101a]/80 backdrop-blur-sm hover:border-blue-500/30 transition-all group" data-tab="tab-events">
        <div class="flex items-center justify-between mb-2">
          <span class="text-[11px] font-mono uppercase tracking-wider text-neutral-400">Events & Drives</span>
          <span class="text-xs text-blue-400 group-hover:translate-x-0.5 transition-transform">→</span>
        </div>
        <div class="text-lg sm:text-xl font-bold tracking-tight text-white">
          {eventsList.length} <span class="text-xs font-normal text-neutral-400">scheduled</span>
        </div>
        <div class="text-[11px] font-mono text-neutral-400 mt-1">
          Manage upcoming workshops
        </div>
      </button>

      <!-- Stat 3: Gallery -->
      <button class="quick-jump-btn text-left p-4 sm:p-5 rounded-2xl border border-white/[0.08] bg-[#0c101a]/80 backdrop-blur-sm hover:border-amber-500/30 transition-all group" data-tab="tab-gallery">
        <div class="flex items-center justify-between mb-2">
          <span class="text-[11px] font-mono uppercase tracking-wider text-neutral-400">S3 Media Gallery</span>
          <span class="text-xs text-amber-400 group-hover:translate-x-0.5 transition-transform">→</span>
        </div>
        <div class="text-lg sm:text-xl font-bold tracking-tight text-white">
          {galleryList.length} <span class="text-xs font-normal text-neutral-400">exhibits</span>
        </div>
        <div class="text-[11px] font-mono text-amber-400/90 mt-1">
          Click to upload photos
        </div>
      </button>

      <!-- Stat 4: Personnel -->
      <button class="quick-jump-btn text-left p-4 sm:p-5 rounded-2xl border border-white/[0.08] bg-[#0c101a]/80 backdrop-blur-sm hover:border-purple-500/30 transition-all group" data-tab="tab-members">
        <div class="flex items-center justify-between mb-2">
          <span class="text-[11px] font-mono uppercase tracking-wider text-neutral-400">Guild Personnel</span>
          <span class="text-xs text-purple-400 group-hover:translate-x-0.5 transition-transform">→</span>
        </div>
        <div class="text-lg sm:text-xl font-bold tracking-tight text-white">
          {membersList.length} <span class="text-xs font-normal text-neutral-400">members</span>
        </div>
        <div class="text-[11px] font-mono text-neutral-400 mt-1">
          Mentors & student leads
        </div>
      </button>
    </div>

    <!-- 2. MODERN SEGMENTED TAB NAVIGATION -->
    <div class="p-1.5 rounded-2xl bg-[#0c101a]/90 border border-white/[0.08] shadow-lg backdrop-blur-md overflow-x-auto">
      <div class="flex items-center gap-1.5 min-w-max">
        <button class="tab-btn active px-4 py-2.5 rounded-xl font-mono text-xs font-semibold transition-all flex items-center gap-2" data-tab="tab-appearance">
          <svg class="w-4 h-4 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
          </svg>
          <span>Appearance & Banner</span>
        </button>

        <button class="tab-btn px-4 py-2.5 rounded-xl font-mono text-xs font-medium text-neutral-400 hover:text-white hover:bg-white/[0.04] transition-all flex items-center gap-2" data-tab="tab-content">
          <svg class="w-4 h-4 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
          <span>Webpages Copy</span>
        </button>

        <button class="tab-btn px-4 py-2.5 rounded-xl font-mono text-xs font-medium text-neutral-400 hover:text-white hover:bg-white/[0.04] transition-all flex items-center gap-2" data-tab="tab-events">
          <svg class="w-4 h-4 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span>Events</span>
          <span class="ml-1 px-1.5 py-0.2 rounded-full text-[10px] bg-white/[0.08] text-neutral-300 font-mono">{eventsList.length}</span>
        </button>

        <button class="tab-btn px-4 py-2.5 rounded-xl font-mono text-xs font-medium text-neutral-400 hover:text-white hover:bg-white/[0.04] transition-all flex items-center gap-2" data-tab="tab-gallery">
          <svg class="w-4 h-4 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span>Media & Gallery</span>
          <span class="ml-1 px-1.5 py-0.2 rounded-full text-[10px] bg-white/[0.08] text-neutral-300 font-mono">{galleryList.length}</span>
        </button>

        <button class="tab-btn px-4 py-2.5 rounded-xl font-mono text-xs font-medium text-neutral-400 hover:text-white hover:bg-white/[0.04] transition-all flex items-center gap-2" data-tab="tab-members">
          <svg class="w-4 h-4 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <span>Personnel</span>
          <span class="ml-1 px-1.5 py-0.2 rounded-full text-[10px] bg-white/[0.08] text-neutral-300 font-mono">{membersList.length}</span>
        </button>

        <button class="tab-btn px-4 py-2.5 rounded-xl font-mono text-xs font-medium text-neutral-400 hover:text-white hover:bg-white/[0.04] transition-all flex items-center gap-2" data-tab="tab-projects">
          <svg class="w-4 h-4 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
          </svg>
          <span>Projects</span>
          <span class="ml-1 px-1.5 py-0.2 rounded-full text-[10px] bg-white/[0.08] text-neutral-300 font-mono">{projectsList.length}</span>
        </button>

        <button class="tab-btn px-4 py-2.5 rounded-xl font-mono text-xs font-medium text-neutral-400 hover:text-white hover:bg-white/[0.04] transition-all flex items-center gap-2" data-tab="tab-audit">
          <svg class="w-4 h-4 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <span>Audit Log</span>
        </button>
      </div>
    </div>

    <!-- TAB 1: APPEARANCE & BANNER -->
    <section id="tab-appearance" class="tab-content space-y-6">
      <form id="settings-form" class="space-y-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <!-- Left: Global Theme & Status -->
          <div class="p-6 rounded-2xl border border-white/[0.08] bg-[#0c101a]/80 backdrop-blur-sm space-y-6">
            <div>
              <h2 class="text-sm font-mono font-bold uppercase tracking-wider text-white flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-blue-500"></span>
                THEME ACCENT & TELEMETRY
              </h2>
              <p class="text-xs text-neutral-400 mt-1">Configure live brand styling and telemetry bar without writing code.</p>
            </div>

            <!-- Visual Accent Picker -->
            <div class="space-y-2">
              <label class="block text-xs font-mono text-neutral-300 uppercase font-semibold">Theme Palette Accent</label>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
                <label class="color-swatch-card cursor-pointer p-3 rounded-xl border border-white/10 bg-black/40 hover:border-blue-500/50 transition-all flex items-center gap-2.5">
                  <input type="radio" name="accentColorRadio" value="blue" checked={settings.accentColor === 'blue'} class="accent-radio sr-only" />
                  <span class="w-3.5 h-3.5 rounded-full bg-blue-500 shadow-sm shadow-blue-500/50 shrink-0"></span>
                  <span class="text-xs font-mono text-white">Blue</span>
                </label>
                <label class="color-swatch-card cursor-pointer p-3 rounded-xl border border-white/10 bg-black/40 hover:border-emerald-500/50 transition-all flex items-center gap-2.5">
                  <input type="radio" name="accentColorRadio" value="emerald" checked={settings.accentColor === 'emerald'} class="accent-radio sr-only" />
                  <span class="w-3.5 h-3.5 rounded-full bg-emerald-500 shadow-sm shadow-emerald-500/50 shrink-0"></span>
                  <span class="text-xs font-mono text-white">Emerald</span>
                </label>
                <label class="color-swatch-card cursor-pointer p-3 rounded-xl border border-white/10 bg-black/40 hover:border-amber-500/50 transition-all flex items-center gap-2.5">
                  <input type="radio" name="accentColorRadio" value="amber" checked={settings.accentColor === 'amber'} class="accent-radio sr-only" />
                  <span class="w-3.5 h-3.5 rounded-full bg-amber-500 shadow-sm shadow-amber-500/50 shrink-0"></span>
                  <span class="text-xs font-mono text-white">Amber</span>
                </label>
                <label class="color-swatch-card cursor-pointer p-3 rounded-xl border border-white/10 bg-black/40 hover:border-rose-500/50 transition-all flex items-center gap-2.5">
                  <input type="radio" name="accentColorRadio" value="rose" checked={settings.accentColor === 'rose'} class="accent-radio sr-only" />
                  <span class="w-3.5 h-3.5 rounded-full bg-rose-500 shadow-sm shadow-rose-500/50 shrink-0"></span>
                  <span class="text-xs font-mono text-white">Rose</span>
                </label>
              </div>
              <input type="hidden" id="accentColor" name="accentColor" value={settings.accentColor} />
            </div>

            <!-- Telemetry string -->
            <div class="space-y-2">
              <label for="systemStatus" class="block text-xs font-mono text-neutral-300 uppercase font-semibold">Telemetry Status Bar</label>
              <input
                type="text"
                id="systemStatus"
                name="systemStatus"
                value={settings.systemStatus}
                placeholder="SYSTEMS NORMAL // 2026 CYCLE"
                class="w-full px-4 py-2.5 rounded-xl text-xs font-mono border border-white/[0.09] bg-black/50 text-white placeholder-neutral-500 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all"
              />
              <p class="text-[11px] text-neutral-400">Displayed in the header next to the live connection dot.</p>
            </div>
          </div>

          <!-- Right: Announcement Banner & Live Preview -->
          <div class="p-6 rounded-2xl border border-white/[0.08] bg-[#0c101a]/80 backdrop-blur-sm space-y-6">
            <div class="flex items-center justify-between">
              <div>
                <h2 class="text-sm font-mono font-bold uppercase tracking-wider text-white flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                  ANNOUNCEMENT TOP RIBBON
                </h2>
                <p class="text-xs text-neutral-400 mt-1">Broadcast high-priority notices across all pages.</p>
              </div>

              <!-- Animated Toggle Switch -->
              <label class="relative inline-flex items-center cursor-pointer">
                <input
                  type="checkbox"
                  id="bannerActive"
                  name="bannerActive"
                  checked={settings.bannerActive}
                  class="sr-only peer"
                />
                <div class="w-11 h-6 bg-white/[0.1] peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
              </label>
            </div>

            <div class="space-y-4">
              <div>
                <label for="bannerText" class="block text-xs font-mono text-neutral-300 uppercase font-semibold mb-1">Ribbon Text</label>
                <input
                  type="text"
                  id="bannerText"
                  name="bannerText"
                  value={settings.bannerText}
                  placeholder="e.g. Registrations for Cyber Safety Hackathon 2026 are open!"
                  class="w-full px-4 py-2.5 rounded-xl text-xs font-mono border border-white/[0.09] bg-black/50 text-white placeholder-neutral-500 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all"
                />
              </div>

              <div>
                <label for="bannerLink" class="block text-xs font-mono text-neutral-300 uppercase font-semibold mb-1">Target Link (Optional)</label>
                <input
                  type="text"
                  id="bannerLink"
                  name="bannerLink"
                  value={settings.bannerLink}
                  placeholder="e.g. /events or /contact"
                  class="w-full px-4 py-2.5 rounded-xl text-xs font-mono border border-white/[0.09] bg-black/50 text-white placeholder-neutral-500 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all"
                />
              </div>

              <!-- Live Ribbon Mock Preview -->
              <div class="pt-2">
                <div class="text-[11px] font-mono text-neutral-400 uppercase tracking-wider mb-2">Live Preview</div>
                <div id="banner-preview" class={`p-3 rounded-xl border text-xs font-mono flex items-center justify-between transition-all ${settings.bannerActive ? 'bg-blue-950/40 border-blue-500/30 text-blue-200' : 'bg-white/[0.02] border-white/[0.06] text-neutral-500'}`}>
                  <span id="preview-text" class="truncate">{settings.bannerText || 'No active announcement'}</span>
                  <span id="preview-badge" class={`text-[10px] px-2 py-0.5 rounded-full font-semibold ${settings.bannerActive ? 'bg-blue-500/20 text-blue-300' : 'bg-neutral-800 text-neutral-500'}`}>
                    {settings.bannerActive ? 'ACTIVE' : 'DISABLED'}
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="flex justify-end">
          <button type="submit" class="btn-cyber-primary px-6 py-2.5 text-xs font-mono font-bold shadow-lg shadow-blue-500/20">
            SAVE GLOBAL SETTINGS →
          </button>
        </div>
      </form>
    </section>

    <!-- TAB 2: ALL WEBPAGES COPY -->
    <section id="tab-content" class="tab-content hidden space-y-6">
      <div class="p-6 rounded-2xl border border-white/[0.08] bg-[#0c101a]/80 backdrop-blur-sm space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-white/[0.06]">
          <div>
            <h2 class="text-sm font-mono font-bold uppercase tracking-wider text-white">// LIVE WEBPAGE COPY EDITOR</h2>
            <p class="text-xs text-neutral-400 mt-1">Edit headlines, leads, and mission text across all public routes.</p>
          </div>

          <!-- Page Pill Switcher -->
