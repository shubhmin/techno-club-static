          <div>
            <h2 class="text-sm font-mono font-bold uppercase tracking-wider text-white">// EVENTS & ACTIVITIES DISPATCH</h2>
            <p class="text-xs text-neutral-400 mt-1">Broadcast workshops, competitions, inter-house debates, or cyber drills.</p>
          </div>
          <button id="add-event-toggle-btn" class="btn-cyber-primary text-xs font-mono font-bold flex items-center gap-2">
            <span id="event-toggle-icon">+</span>
            <span>CREATE NEW EVENT</span>
          </button>
        </div>

        <!-- Add Event Collapsible Drawer -->
        <form id="event-form" class="hidden p-5 rounded-2xl border border-blue-500/20 bg-blue-950/20 space-y-4">
          <div class="text-xs font-mono font-bold text-blue-400 uppercase tracking-wider">// SCHEDULE NEW CALENDAR EVENT</div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
              <label for="event-title" class="block text-[11px] font-mono text-neutral-300 uppercase mb-1">Event Title</label>
              <input type="text" id="event-title" placeholder="e.g. Prompt Engineering Invitational" required class="w-full px-3.5 py-2 rounded-xl text-xs font-mono border border-white/10 bg-black/60 text-white" />
            </div>
            <div>
              <label for="event-track" class="block text-[11px] font-mono text-neutral-300 uppercase mb-1">Track</label>
              <select id="event-track" class="w-full px-3.5 py-2 rounded-xl text-xs font-mono border border-white/10 bg-black/60 text-white">
                <option value="WORKSHOP">Workshop</option>
                <option value="COMPETITION">Competition</option>
                <option value="CTF">Capture The Flag (CTF)</option>
                <option value="SEMINAR">Seminar / Keynote</option>
                <option value="DRIVE">Awareness Drive</option>
              </select>
            </div>
            <div>
              <label for="event-date" class="block text-[11px] font-mono text-neutral-300 uppercase mb-1">Date & Time</label>
              <input type="text" id="event-date" placeholder="e.g. Nov 14, 2026 · 10:00 AM" required class="w-full px-3.5 py-2 rounded-xl text-xs font-mono border border-white/10 bg-black/60 text-white" />
            </div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="event-location" class="block text-[11px] font-mono text-neutral-300 uppercase mb-1">Location</label>
              <input type="text" id="event-location" placeholder="e.g. Senior Computer Lab 2" required class="w-full px-3.5 py-2 rounded-xl text-xs font-mono border border-white/10 bg-black/60 text-white" />
            </div>
            <div>
              <label for="event-reglink" class="block text-[11px] font-mono text-neutral-300 uppercase mb-1">Registration Link (optional)</label>
              <input type="text" id="event-reglink" placeholder="https://forms.gle/... or /contact" class="w-full px-3.5 py-2 rounded-xl text-xs font-mono border border-white/10 bg-black/60 text-white" />
            </div>
          </div>
          <div>
            <label for="event-desc" class="block text-[11px] font-mono text-neutral-300 uppercase mb-1">Description</label>
            <textarea id="event-desc" rows="2" placeholder="Brief outline of event goals and syllabus..." required class="w-full px-3.5 py-2 rounded-xl text-xs font-mono border border-white/10 bg-black/60 text-white"></textarea>
          </div>
          <div class="flex justify-end gap-2">
            <button type="button" id="event-cancel-btn" class="px-4 py-2 rounded-xl text-xs font-mono border border-white/10 text-neutral-400 hover:text-white">Cancel</button>
            <button type="submit" class="btn-cyber-primary text-xs font-mono font-bold">+ PUBLISH TO SCHEDULE</button>
          </div>
        </form>

        <!-- Events List -->
        {eventsList.length === 0 ? (
          <div class="p-8 text-center rounded-2xl border border-dashed border-white/10 bg-black/20 text-neutral-400 text-xs font-mono">
            No events scheduled yet. Click "+ Create New Event" above to add your first mission.
          </div>
        ) : (
          <div class="overflow-x-auto">
            <table class="w-full text-left font-mono text-xs border-collapse">
              <thead>
                <tr class="border-b border-white/[0.08] text-neutral-400 text-[11px]">
                  <th class="py-3 px-3">TITLE</th>
                  <th class="py-3 px-3">TRACK</th>
                  <th class="py-3 px-3">DATE & LOCATION</th>
                  <th class="py-3 px-3">STATUS</th>
                  <th class="py-3 px-3 text-right">ACTION</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-white/[0.04]">
                {eventsList.map((e) => (
                  <tr class="hover:bg-white/[0.02] transition-colors">
                    <td class="py-3.5 px-3 font-bold text-white">
                      <div>{e.title}</div>
                      <div class="text-[11px] text-neutral-400 font-normal line-clamp-1">{e.description}</div>
                    </td>
                    <td class="py-3.5 px-3">
                      <span class="px-2 py-0.5 rounded-full bg-blue-500/10 text-blue-400 text-[10px] font-semibold border border-blue-500/20">{e.track}</span>
                    </td>
                    <td class="py-3.5 px-3 text-neutral-300">
                      <div>{e.eventDate}</div>
                      <div class="text-[10px] text-neutral-500">{e.location}</div>
                    </td>
                    <td class="py-3.5 px-3">
                      <span class="px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 text-[10px] font-semibold border border-emerald-500/20">{e.status}</span>
                    </td>
                    <td class="py-3.5 px-3 text-right">
                      <button class="delete-event-btn text-red-400 hover:text-red-300 hover:underline px-2 py-1 rounded" data-id={e.id}>DELETE</button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </section>

    <!-- TAB 4: GALLERY & S3 MEDIA -->
    <section id="tab-gallery" class="tab-content hidden space-y-6">
      <div class="p-6 rounded-2xl border border-white/[0.08] bg-[#0c101a]/80 backdrop-blur-sm space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-4 border-b border-white/[0.06]">
          <div>
            <h2 class="text-sm font-mono font-bold uppercase tracking-wider text-white flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              S3 OBJECT STORAGE & EXHIBIT GALLERY
            </h2>
            <p class="text-xs text-neutral-400 mt-1">Upload images straight to Neon S3 (`techno-club` bucket) with permanent immutable edge caching.</p>
          </div>
          <div class="flex items-center gap-2 text-xs font-mono text-neutral-400">
            <span class="px-2.5 py-1 rounded-lg bg-white/[0.04] border border-white/10 text-emerald-300">Bucket: {s3Bucket}</span>
          </div>
        </div>

        <!-- Modern S3 Drag-and-Drop Zone -->
        <div id="dropzone" class="p-8 rounded-2xl border-2 border-dashed border-white/20 bg-black/40 hover:border-blue-500/50 hover:bg-black/60 transition-all text-center cursor-pointer group">
          <input type="file" id="media-file-input" accept="image/*" class="hidden" />
