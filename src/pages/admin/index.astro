            </button>
          </div>
          <div id="upload-status" class="hidden mt-4 p-3 rounded-xl border border-emerald-500/30 bg-emerald-950/30 text-xs font-mono text-emerald-300"></div>
        </div>

        <!-- Add Gallery Item Form -->
        <form id="gallery-form" class="p-5 rounded-2xl border border-white/[0.08] bg-black/40 space-y-4">
          <div class="text-xs font-mono font-bold text-white uppercase tracking-wider">// ATTACH PHOTO TO EXHIBIT GALLERY</div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
              <label for="gallery-year" class="block text-[11px] font-mono text-neutral-400 uppercase mb-1">Academic Cycle</label>
              <input type="text" id="gallery-year" placeholder="2025–2026" required class="w-full px-3.5 py-2 rounded-xl text-xs font-mono border border-white/10 bg-black/60 text-white" />
            </div>
            <div>
              <label for="gallery-album" class="block text-[11px] font-mono text-neutral-400 uppercase mb-1">Album Title</label>
              <input type="text" id="gallery-album" placeholder="e.g. AI Prompting Labs" required class="w-full px-3.5 py-2 rounded-xl text-xs font-mono border border-white/10 bg-black/60 text-white" />
            </div>
            <div>
              <label for="gallery-caption" class="block text-[11px] font-mono text-neutral-400 uppercase mb-1">Caption / Description</label>
              <input type="text" id="gallery-caption" placeholder="e.g. Demonstration Round" required class="w-full px-3.5 py-2 rounded-xl text-xs font-mono border border-white/10 bg-black/60 text-white" />
            </div>
          </div>
          <div>
            <label for="gallery-image-url" class="block text-[11px] font-mono text-neutral-400 uppercase mb-1">Image URL (Populated automatically after upload, or enter /api/media/...)</label>
            <input type="text" id="gallery-image-url" placeholder="e.g. /api/media/1 or /assets/gallery/A.webp" required class="w-full px-3.5 py-2 rounded-xl text-xs font-mono border border-white/10 bg-black/60 text-white" />
          </div>
          <div class="flex justify-end">
