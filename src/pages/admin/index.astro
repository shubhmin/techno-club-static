            <input type="text" id="projects-title" class="w-full px-4 py-2.5 rounded-xl text-xs font-mono border border-white/[0.09] bg-black/50 text-white" data-page="projects" data-key="title" value={projectsContent.title} />
          </div>
          <div>
            <label for="projects-lead" class="block text-xs font-mono text-neutral-300 uppercase font-semibold mb-1">Projects Page Lead</label>
            <textarea id="projects-lead" rows="4" class="w-full px-4 py-2.5 rounded-xl text-xs font-mono border border-white/[0.09] bg-black/50 text-white" data-page="projects" data-key="lead">{projectsContent.lead}</textarea>
