---
import Base from '@/layouts/Base.astro';
---

<Base title="Projects — Techno Sreshtha" activePage="projects">
  <section class="section-container py-16">
    <h1 class="reveal page-heading text-center">Scratch Projects</h1>
    <p class="reveal page-lead text-center mx-auto">
      Projects from students in smaller classes — showing responsible tech values from a young age.
    </p>

    <div class="mt-12 flex gap-6 flex-wrap justify-center reveal">
      <!-- Embed slots for Scratch projects -->
      <div class="card text-center py-12 px-8 w-full max-w-lg">
        <div class="text-surface-400 dark:text-surface-500">
          <svg class="w-12 h-12 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <p class="font-medium">Projects coming soon</p>
          <p class="text-sm mt-1">Scratch project embeds will appear here.</p>
        </div>
      </div>
    </div>
  </section>
</Base>
