---
import Base from '@/layouts/Base.astro';
import { getPageContent, getProjects } from '@/lib/content';

const content = await getPageContent('projects');
const projects = await getProjects();
---

<Base title="Student Labs & Projects — Techno Sreshtha" activePage="projects">
  <section class="py-12 sm:py-20">
    <div class="tech-container">
      <!-- Header -->
      <div class="max-w-3xl mb-16">
        <span class="tech-badge mb-2">STUDENT BUILDS &amp; LABS</span>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-neutral-900 dark:text-white">
          {content.title || 'Practical Security Engineered by Students'}
        </h1>
        <p class="text-base text-neutral-600 dark:text-neutral-400 mt-4 leading-relaxed">
          {content.lead || 'From Scratch games for primary classes to client-side cryptographic calculators and AI prompt audit tools—here is what our members build.'}
        </p>
      </div>

      <!-- Projects Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-16">
        {projects.map((p) => (
          <div class="cyber-card p-8 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between text-xs font-mono mb-4">
                <span class="px-2 py-0.5 rounded border border-blue-500/30 text-blue-400 font-semibold">
                  {p.categoryTag}
                </span>
                <span class="text-neutral-400">{p.status}</span>
              </div>
              <h2 class="text-xl font-bold text-neutral-900 dark:text-white mb-2">{p.title}</h2>
              <div class="text-[11px] font-mono text-neutral-500 mb-3">{p.track}</div>
              <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed mb-6">
                {p.description}
              </p>
            </div>

            <div class="pt-6 border-t border-black/[0.06] dark:border-white/[0.08] flex items-center justify-between">
              {p.linkUrl ? (
                <a
                  href={p.linkUrl}
                  target={p.linkUrl.startsWith('http') ? '_blank' : undefined}
                  class="btn-cyber-outline text-xs"
                >
                  Explore Project →
                </a>
              ) : (
                <span class="text-xs font-mono text-neutral-500">Internal Demo</span>
              )}
            </div>
          </div>
        ))}
      </div>

      <!-- Submit a Project Proposal Banner -->
      <div class="cyber-card p-8 bg-neutral-100 dark:bg-[#0c1017] flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <span class="tech-badge mb-2">OPEN SUBMISSIONS</span>
          <h3 class="text-xl font-bold text-neutral-900 dark:text-white">Have a cyber tool or Scratch game to showcase?</h3>
          <p class="text-xs text-neutral-500 mt-1 max-w-xl">
            Club members can propose and demo their projects during Thursday lab sessions. Faculty mentors provide code reviews and hosting assistance.
          </p>
        </div>
        <a href="/contact" class="btn-cyber-primary text-xs shrink-0">Submit A Project Proposal</a>
      </div>
    </div>
  </section>
</Base>
