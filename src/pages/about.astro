---
import Base from '@/layouts/Base.astro';

const timeline = [
  {
    phase: 'PHASE 01 // FOUNDATION',
    year: '2023',
    title: 'Establishment of the Cyber Safety Cell',
    summary: 'Founded by senior students and computer faculty to address emerging digital footprint vulnerabilities and spearhead peer-led cyber hygiene workshops.',
  },
  {
    phase: 'PHASE 02 // EXPANSION',
    year: '2024',
    title: 'Inter-House Debate & Poster Campaigns',
    summary: 'Scaled across middle and senior wings with 5+ workshops, poster exhibitions, and password entropy challenges across 500+ participating students.',
  },
  {
    phase: 'PHASE 03 // EVOLUTION',
    year: '2025',
    title: 'Incorporation of Ethical AI Charter',
    summary: 'Integrated algorithmic auditing, generative AI prompt ethics, and anti-plagiarism verification into the core club curriculum.',
  },
  {
    phase: 'PHASE 04 // CURRENT',
    year: '2026',
    title: 'Open Source Security Tools & Portals',
    summary: 'Deploying student-built security tools, Scratch junior education modules, and establishing continuous cyber advisories for the school.',
  },
];

const pillars = [
  {
    title: 'RADICAL PRACTICALITY',
    desc: 'No theoretical lectures without live demonstration. Every concept—from SQL injection to prompt injection—is demonstrated in safe, isolated labs.',
  },
  {
    title: 'PEER-TO-PEER MENTORSHIP',
    desc: 'Senior guild members mentor junior students, breaking down intimidating technical jargon into accessible, engaging modules.',
  },
  {
    title: 'ETHICS FIRST',
    desc: 'Offensive cybersecurity knowledge is only taught with rigorous ethical boundaries. We train white-hat defenders, not rogue actors.',
  },
];
---

<Base title="Charter & Origins — Techno Sreshtha" activePage="about">
  <section class="py-12 sm:py-20">
    <div class="tech-container">
      <!-- Title -->
      <div class="max-w-3xl mb-16">
        <span class="tech-badge mb-2">CLUB CHARTER &amp; MANIFESTO</span>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-neutral-900 dark:text-white">
          Defending our campus in the age of synthetic media.
        </h1>
        <p class="text-base text-neutral-600 dark:text-neutral-400 mt-4 leading-relaxed">
          Techno Sreshtha was established at DAV Public School, Sreshtha Vihar, with a singular mission: to transition students from passive, vulnerable consumers of technology into proactive, ethical digital citizens.
        </p>
      </div>

      <!-- Core Tenets -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-20">
        {pillars.map((p) => (
          <div class="cyber-card p-6">
            <div class="text-xs font-mono font-bold text-blue-600 dark:text-blue-400 mb-2">{p.title}</div>
            <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
              {p.desc}
            </p>
          </div>
        ))}
      </div>

      <!-- Timeline / Changelog Style -->
      <div class="mb-20">
        <div class="max-w-2xl mb-10">
          <span class="tech-badge mb-1">CHRONOLOGY</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-neutral-900 dark:text-white">
            Our Journey &amp; Milestones
          </h2>
        </div>

        <div class="relative border-l border-neutral-300 dark:border-white/10 ml-4 pl-6 sm:pl-8 space-y-12">
          {timeline.map((item) => (
            <div class="relative group">
              <!-- Dot marker -->
              <div class="absolute -left-[31px] sm:-left-[39px] top-1.5 w-3.5 h-3.5 rounded-full border-2 border-white dark:border-[#07090e] bg-blue-500 group-hover:scale-125 transition-transform"></div>
              
              <div class="flex items-center gap-2 font-mono text-xs text-neutral-500 mb-1">
                <span class="font-bold text-neutral-900 dark:text-white">{item.year}</span>
                <span>//</span>
                <span>{item.phase}</span>
              </div>
              <h3 class="text-lg font-bold text-neutral-900 dark:text-white mb-2">{item.title}</h3>
              <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 max-w-2xl leading-relaxed">
                {item.summary}
              </p>
            </div>
          ))}
        </div>
      </div>

      <!-- School & Venue Card -->
      <div class="cyber-card p-8 bg-neutral-100 dark:bg-[#0c1017] flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <span class="text-xs font-mono text-emerald-500 font-bold uppercase">AFFILIATION</span>
          <h3 class="text-xl font-bold text-neutral-900 dark:text-white mt-1">DAV Public School, Sreshtha Vihar</h3>
          <p class="text-xs text-neutral-500 mt-1">
            Delhi, India · Affiliated with DAV College Managing Committee &amp; CBSE.
          </p>
        </div>
        <div class="flex gap-3 shrink-0">
          <a href="/members" class="btn-cyber-primary text-xs">Meet The Team</a>
          <a href="/contact" class="btn-cyber-outline text-xs">Connect With Us</a>
        </div>
      </div>
    </div>
  </section>
</Base>
