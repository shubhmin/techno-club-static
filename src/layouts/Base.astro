---
interface Props {
  title?: string;
  description?: string;
  activePage?: string;
}

const {
  title = 'Techno Sreshtha — Cyber Defense & Ethical AI Guild',
  description = "The official student cybersecurity and AI ethics organization at DAV Public School, Sreshtha Vihar.",
  activePage = '',
} = Astro.props;

import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/global.css';
import { getSiteSettings } from '@/lib/content';

const settings = await getSiteSettings();
---

<!doctype html>
<html lang="en" class="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/assets/logo.webp" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- Pre-render theme state to prevent flash of wrong theme -->
  <script is:inline>
    const theme = (() => {
      if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
        return localStorage.getItem('theme');
      }
      return 'dark'; // default to sophisticated dark
    })();
    if (theme === 'light') {
      document.documentElement.classList.remove('dark');
    } else {
      document.documentElement.classList.add('dark');
    }
  </script>
</head>

<body class="min-h-screen flex flex-col bg-[#f8fafc] dark:bg-[#07090e] text-neutral-900 dark:text-neutral-100 antialiased selection:bg-blue-500/20 selection:text-blue-400">
  <!-- Subtle technical grid background -->
  <div class="fixed inset-0 pointer-events-none opacity-40 dark:opacity-20 bg-grid-pattern [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)]"></div>

  <!-- Dynamic Announcement Ribbon (Managed from /admin) -->
  {settings.bannerActive && settings.bannerText && (
    <div class="relative z-50 py-2 px-4 bg-gradient-to-r from-blue-600 to-indigo-600 text-white text-xs font-mono text-center flex items-center justify-center gap-2 shadow-md">
      <span class="inline-block px-1.5 py-0.2 rounded bg-white/20 text-[10px] font-bold uppercase tracking-wider">BULLETIN</span>
      <span>{settings.bannerText}</span>
      {settings.bannerLink && (
        <a href={settings.bannerLink} class="underline font-bold hover:text-white/80 ml-1">
          Learn More →
        </a>
      )}
    </div>
  )}

  <Header activePage={activePage} />

  <main class="flex-1 relative z-10">
    <slot />
  </main>

  <Footer systemStatus={settings.systemStatus} />

  <script>
    // Theme toggle handling
    const html = document.documentElement;
    const toggle = document.getElementById('theme-toggle');
    toggle?.addEventListener('click', () => {
      const isDark = html.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });

    // Observer for reveal effects
    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -30px 0px' }
    );
    document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el));
  </script>
</body>
</html>
