---
const sitemap = [
  {
    title: 'OPERATIONS',
    links: [
      { label: 'Club Charter', href: '/about' },
      { label: 'Ethical AI Directive', href: '/ethical-ai' },
      { label: 'Interactive Labs', href: '/projects' },
      { label: 'Event Archives', href: '/gallery' },
    ],
  },
  {
    title: 'COMMUNITY',
    links: [
      { label: 'Guild Core & Faculty', href: '/members' },
      { label: 'Join or Partner', href: '/contact' },
      { label: 'School Portal', href: 'https://davsreshtha.com', external: true },
    ],
  },
  {
    title: 'TOOLS & DOCS',
    links: [
      { label: 'Interactive Terminal', href: '/chatbot' },
      { label: 'Password Entropy Lab', href: '/#entropy-lab' },
      { label: 'Phishing Detection Drill', href: '/#phishing-drill' },
    ],
  },
];
---

<footer class="mt-24 border-t border-black/[0.06] dark:border-white/[0.08] bg-neutral-50 dark:bg-[#05070a] text-neutral-600 dark:text-neutral-400">
  <!-- System Status Banner -->
  <div class="border-b border-black/[0.06] dark:border-white/[0.08] py-3 text-xs font-mono">
    <div class="tech-container flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center gap-2">
        <div class="live-dot">
          <span></span>
          <span></span>
        </div>
        <span class="text-neutral-800 dark:text-neutral-200">GUILD SYSTEMS: NORMAL</span>
        <span class="text-neutral-400">|</span>
        <span class="text-neutral-500">DAV SRESHHTA VIHAR // NEW DELHI</span>
      </div>
      <div class="text-neutral-500 hidden sm:block">
        BUILD PROTOCOL: ASTRO v5.7 (ZERO CLIENT BLOAT)
      </div>
    </div>
  </div>

  <div class="tech-container py-16">
    <div class="grid grid-cols-1 md:grid-cols-5 gap-10">
      <!-- Col 1: Bio -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-2.5">
          <img src="/assets/logo.webp" alt="Logo" class="h-8 w-8 rounded-lg" />
          <span class="font-bold text-sm tracking-tight text-neutral-900 dark:text-white">TECHNO SRESHTHA</span>
        </div>
        <p class="text-xs leading-relaxed text-neutral-500 dark:text-neutral-400 max-w-sm">
          The cybersecurity, digital defense, and ethical AI guild at DAV Public School, Sreshtha Vihar. Researching vulnerabilities, instilling digital privacy, and building student-engineered software.
        </p>
        <div class="pt-2 text-xs font-mono text-neutral-400">
          EST. 2023 · NON-PROFIT STUDENT GUILD
        </div>
      </div>

      <!-- Links columns -->
      {sitemap.map((col) => (
        <div>
          <h4 class="text-[11px] font-mono tracking-wider text-neutral-900 dark:text-white uppercase font-bold mb-4">
            {col.title}
          </h4>
          <ul class="space-y-2.5 text-xs">
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                  class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors inline-flex items-center gap-1"
                >
                  {link.label}
                  {link.external && <span class="text-[10px]">↗</span>}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom credits -->
    <div class="mt-14 pt-8 border-t border-black/[0.06] dark:border-white/[0.08] flex flex-col sm:flex-row items-center justify-between text-xs text-neutral-400 gap-4">
      <p>© 2026 Techno Sreshtha Cyber Safety Club · DAV Public School, Sreshtha Vihar.</p>
      <div class="flex items-center gap-4 text-xs font-mono">
        <span class="text-emerald-500 font-semibold">SECURE HTTPS</span>
        <span>·</span>
        <span>VERCEL EDGE HOSTED</span>
      </div>
    </div>
  </div>
</footer>
